model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  address   String?
  image     String?
  createAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relation for Movie and review
  movieList Movie[]  @relation("UserWatchList")
  review    Review[]

  @@map("users")
}

model Movie {
  id          String   @id @default(uuid())
  name        String
  releaseDate DateTime
  director    String
  genre       String

  createAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relation for users
  movieWatchUser User[]   @relation("UserWatchList")
  review         Review[]

  @@map("moves")
}

model Review {
  id      String @id @default(ulid())
  movieId String
  userId  String

  reviewDescription String
  createAt          DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relation uses and movie
  movie Movie @relation(fields: [movieId], references: [id])
  users User  @relation(fields: [userId], references: [id])

  @@map("reviews")
}
